# Copiez ce fichier en .env (jamais versionné) et renseignez vos valeurs.
MISTRAL_API_KEY=
# Instance dédiée : racine de l'API (sans /v1), lue par l'Agents SDK ; craft_support la recopie dans SERVER_URL
# pour le worker Workflows. Le worker s'enregistre à la même adresse + /v2/agents : les deux lignes changent
# ensemble. Lignes commentées : API publique (https://api.mistral.ai).
MISTRAL_API_URL=https://api.7c746bb36ad3.dc.mistral.ai
AGENTS_SDK_DEPLOY_CONTROL_PLANE_URL=https://api.7c746bb36ad3.dc.mistral.ai/v2/agents
